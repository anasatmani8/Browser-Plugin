{
  "manifest_version": 3,
  "name": "Page Tools",
  "version": "1.1",
  "description": "Translate the current webpage or change its background color",
  "action": {
      "default_popup": "popup.html",
      "default_icon": "icon.png"
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["<all_urls>"]
}
